<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="kaya">

  <!-- ==================================================================
       MEASURED 2026-08-28. Values marked ESTIMATE are still guesses.
       Source of truth: cad/kaya_dimensions.yaml
       ================================================================== -->

  <!-- Wheels: 74 mm outer diameter, double-row omni. -->
  <xacro:property name="wheel_radius"   value="0.037"/>   <!-- MEASURED -->
  <xacro:property name="wheel_width"    value="0.025"/>   <!-- MEASURED (double row) -->

  <!-- Distance from the rotation axis to each wheel's floor contact patch.
       This is the L in the omni kinematics matrix; Phase 2 refines it by
       spinning the robot a known number of turns. -->
  <xacro:property name="chassis_radius" value="0.150"/>   <!-- MEASURED -->

  <!-- Circumscribing radius for collision. The real deck is a truncated
       triangle; a circle that encloses it is the correct conservative
       footprint for Nav2 and is convex, which PhysX wants. -->
  <xacro:property name="footprint_radius" value="0.160"/> <!-- ESTIMATE -->
  <xacro:property name="chassis_height" value="0.130"/>   <!-- ESTIMATE from photos -->

  <!-- Camera: measured to the module centre, relative to base_link. -->
  <xacro:property name="camera_x" value="0.025"/>         <!-- MEASURED -->
  <xacro:property name="camera_y" value="0.000"/>         <!-- MEASURED -->
  <!-- Measured 165 mm ABOVE THE FLOOR. base_link sits one wheel radius (37 mm)
       up, so this value - which is relative to base_link - is 165-37 = 128 mm. -->
  <xacro:property name="camera_z" value="${0.165 - wheel_radius}"/>  <!-- MEASURED -->
  <!-- URDF rpy pitch is positive NOSE DOWN, so a nose-UP camera is negative.
       -0.0853 rad = 4.89 deg UP, derived from the IMU's gravity vector, which
       agrees with the visual estimate of "about 5 degrees up" to within 0.1 deg. -->
  <xacro:property name="camera_pitch" value="-0.0853"/>   <!-- MEASURED (IMU) -->
  <xacro:property name="camera_roll"  value="-0.0164"/>   <!-- MEASURED (IMU), 0.94 deg -->

  <!-- Mass: 2.088 kg total, measured. The split is an ESTIMATE until the
       wheels are weighed separately. -->
  <xacro:property name="total_mass"  value="2.088"/>      <!-- MEASURED -->
  <xacro:property name="wheel_mass"  value="0.060"/>      <!-- ESTIMATE -->
  <xacro:property name="base_mass"   value="${total_mass - 3*wheel_mass}"/>

  <material name="grey">  <color rgba="0.28 0.29 0.31 1.0"/></material>
  <material name="black"> <color rgba="0.10 0.10 0.12 1.0"/></material>
  <material name="teal">  <color rgba="0.05 0.55 0.62 1.0"/></material>

  <!-- REP-105: map -> odom -> base_footprint -> base_link -->
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <geometry><cylinder radius="${footprint_radius}" length="${chassis_height}"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry><cylinder radius="${footprint_radius}" length="${chassis_height}"/></geometry>
    </collision>
    <inertial>
      <mass value="${base_mass}"/>
      <!-- Solid-cylinder approximation. Replaced by Fusion's computed tensor
           once the CAD model exists; that is the main reason to build it. -->
      <inertia
        ixx="${base_mass*(3*footprint_radius*footprint_radius + chassis_height*chassis_height)/12}"
        iyy="${base_mass*(3*footprint_radius*footprint_radius + chassis_height*chassis_height)/12}"
        izz="${base_mass*footprint_radius*footprint_radius/2}"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- ==================================================================
       Wheel layout, confirmed from photos: TWO WHEELS FORWARD flanking the
       camera, ONE WHEEL AT THE REAR. So the angles from +X are 60, 180, 300
       degrees, NOT 0/120/240.

       WARNING - which SERVO ID sits at which angle is NOT yet verified.
       The names below are provisional. Confirm before writing the Phase 2
       kinematics, or the robot will strafe when told to rotate.
       ================================================================== -->
  <xacro:macro name="omni_wheel" params="name theta">
    <link name="${name}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia
          ixx="${wheel_mass*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)/12}"
          iyy="${wheel_mass*wheel_radius*wheel_radius/2}"
          izz="${wheel_mass*(3*wheel_radius*wheel_radius + wheel_width*wheel_width)/12}"
          ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/><child link="${name}_wheel_link"/>
      <origin xyz="${chassis_radius*cos(theta)} ${chassis_radius*sin(theta)} 0"
              rpy="0 0 ${theta}"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:omni_wheel name="wheel_1" theta="${pi/3}"/>      <!-- 60 deg, front-left -->
  <xacro:omni_wheel name="wheel_2" theta="${pi}"/>        <!-- 180 deg, rear -->
  <xacro:omni_wheel name="wheel_3" theta="${5*pi/3}"/>    <!-- 300 deg, front-right -->

  <!-- ==================================================================
       Camera. We publish base_link -> camera_link ONLY; the Orbbec driver
       supplies the rest of the chain on /tf_static. Duplicating any of it
       would give TF two parents for one frame.
       ================================================================== -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.025 0.150 0.030"/></geometry>
      <material name="teal"/>
    </visual>
  </link>
  <joint name="camera_mount_joint" type="fixed">
    <parent link="base_link"/><child link="camera_link"/>
    <origin xyz="${camera_x} ${camera_y} ${camera_z}"
            rpy="${camera_roll} ${camera_pitch} 0"/>
  </joint>

  <!-- Legacy external MPU-6050: kept as a documented fallback, not used by the
       navigation stack. Position still unmeasured. -->
  <link name="mpu6050_link"/>
  <joint name="mpu6050_joint" type="fixed">
    <parent link="base_link"/><child link="mpu6050_link"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>   <!-- TODO measure -->
  </joint>

</robot>
