<?xml version="1.0"?>
<package format="3">
  <name>kaya_bringup</name>
  <version>0.1.0</version>
  <description>Launch files composing the Kaya robot stack.</description>
  <maintainer email="atomicrajat619@gmail.com">Rajat</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>kaya_imu</exec_depend>
  <exec_depend>kaya_description</exec_depend>
  <exec_depend>orbbec_camera</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>isaac_ros_visual_slam</exec_depend>
  <!-- cuvslam_origin_anchor: reads the tracker's status and localization
       verdict, and verifies the pose it produced against TF. -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>isaac_ros_visual_slam_interfaces</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>nvblox_msgs</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
